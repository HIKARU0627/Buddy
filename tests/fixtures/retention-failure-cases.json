      "clock_state": "verified",
      "sweep": {
        "epoch": "e1",
        "status": "completed",
        "completed_at": "2031-06-01T00:09:00Z",
        "failed_actions": 0,
        "use_blocked": []
      },
      "expected_reasons": []
    },
    {
      "id": "clock-state-omitted-is-verified",
      "now": "2031-06-01T00:10:00Z",
      "last_checked_at": "2031-06-01T00:05:00Z",
      "sweep": {
        "epoch": "e1",
        "status": "completed",
        "completed_at": "2031-06-01T00:09:00Z",
        "failed_actions": 0,
        "use_blocked": []
      },
      "expected_reasons": []
    },
    {
      "id": "undeletable-rows-do-not-close-the-gate-but-block-only-those-rows",
      "now": "2031-06-01T00:10:00Z",
      "last_checked_at": "2031-06-01T00:05:00Z",
      "clock_state": "verified",
      "sweep": {
        "epoch": "e1",
        "status": "completed",
        "completed_at": "2031-06-01T00:09:00Z",
        "failed_actions": 0,
        "use_blocked": [
          { "family": "operation", "id": "op-stuck", "reason": "undeletable" }
        ]
      },
      "expected_reasons": [],
      "usable": [
        { "family": "operation", "id": "op-stuck", "usable": false },
        { "family": "operation", "id": "op-other", "usable": true },
        { "family": "memory", "id": "op-stuck", "usable": true }
      ]
    }
  ]
}
