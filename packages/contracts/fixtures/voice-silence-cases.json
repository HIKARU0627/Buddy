  "blocker_cases": [
    {
      "id": "every-activity-blocks",
      "refs": ["10 §3", "X55"],
      "input": {
        "user_speaking": true,
        "playing": true,
        "delegation": "foreground",
        "screen_event": false,
        "screen_active": true
      },
      "expected": [
        "user_speaking",
        "playing",
        "delegation_foreground",
        "screen_active"
      ]
    },
    {
      "id": "background-delegation-does-not-block",
      "refs": ["10 §5A", "X29", "X55"],
      "input": {
        "delegation": "background"
      },
      "expected": []
    },
    {
      "id": "a-screen-event-alone-is-not-an-ongoing-activity",
      "refs": ["10 §3"],
      "input": {
        "screen_event": true
      },
      "expected": []
    },
    {
      "id": "foreground-delegation",
      "refs": ["10 §3", "X55"],
      "input": {
        "delegation": "foreground"
      },
      "expected": ["delegation_foreground"]
    },
    {
      "id": "playing",
      "refs": ["10 §3", "X55"],
      "input": {
        "playing": true
      },
      "expected": ["playing"]
    },
    {
      "id": "screen-operation-in-progress",
      "refs": ["10 §3", "X55"],
      "input": {
        "screen_active": true
      },
      "expected": ["screen_active"]
    },
    {
      "id": "nothing",
      "refs": ["10 §3"],
      "input": {},
      "expected": []
    }
  ],
  "scenarios": [
    {
      "id": "default-ten-seconds",
      "refs": ["10 §3", "X25"],
      "steps": [
        {
          "at": 0,
          "expect": {
            "decision": "keep",
            "timeout_ms": 10000,
            "remaining_ms": 10000
          }
        },
        {
          "at": 9999,
          "expect": {
            "decision": "keep",
            "timeout_ms": 10000,
            "remaining_ms": 1
          }
        },
        {
          "at": 10000,
          "expect": {
            "decision": "close",
            "timeout_ms": 10000,
            "remaining_ms": 0
          }
        }
      ]
    },
