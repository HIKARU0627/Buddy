{
  "status": "specification_only",
  "description": "方式 C（Live の文字起こしから進める暫定入力）の 4 操作の限定の期待値（設計 10 §5A、09 X51・QA41・QA05・X21、質問 130、ADR 0041）。手書きで、domain の実装から生成していない。進めてよいのは自動実行の 4 操作（用事・メモの登録、ラベルの変更、返信の下書きの保存、自分だけの予定の作成）だけ。参照と聞き返しは入力が確定していなくてもよい。観測の条件が欠ければ blocked（既知の欠落・対応不明・未解決の訂正は C でも blocked）、4 操作でなければ requires_full_text（全文の確定・方式 A・③へ戻す。C のまま画面承認へ昇格させない）。proceed は実行の許可ではなく、実行の可否は readiness.ts と 08 の最終検査が別に決める。",
  "operations": [
    "register_task_or_note",
    "change_label",
    "save_reply_draft",
    "create_own_event"
  ],
  "stable_ms": 300,
  "facts_base": {
    "end_candidate_observed": true,
    "target_range_mapped": true,
    "stable_ms": 300,
    "known_fragment_gap": false,
    "target_turn_unique": true,
    "unresolved_correction": false,
    "missing_args": false,
    "utterance_hold": false,
    "policy_version": "1",
    "own_event_only": true
  },
  "cases": [
    {
      "id": "create-task",
      "refs": ["QA41", "X21", "X51"],
      "intent": "create_task",
      "expected": {
        "decision": "proceed",
        "operation": "register_task_or_note",
        "input_evidence": "live_policy_observed",
        "seal_reason": "live_transcript_policy"
      }
    },
    {
      "id": "create-note",
