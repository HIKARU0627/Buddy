      "expected": true
    },
    {
      "id": "masen-ka",
      "refs": ["10 §3"],
      "text": "行きませんか",
      "expected": true
    },
    {
      "id": "desu-ka",
      "refs": ["10 §3"],
      "text": "これでいいですか?",
      "expected": true
    },
    {
      "id": "deshou-ka",
      "refs": ["10 §3"],
      "text": "どうでしょうか",
      "expected": true
    },
    {
      "id": "desu-ka-with-a-full-stop",
      "refs": ["10 §3"],
      "text": "これでいいですか。",
      "expected": true
    },
    {
      "id": "masu-ka-ne",
      "refs": ["10 §3"],
      "text": "予定を入れますかね。",
      "expected": true
    },
    {
      "id": "masen-ka-with-a-full-stop",
      "refs": ["10 §3"],
      "text": "行きませんか。",
      "expected": true
    },
    {
      "id": "deshou-ka-with-a-full-stop",
      "refs": ["10 §3"],
      "text": "どうでしょうか。",
      "expected": true
    },
    {
      "id": "desu-ka-ne",
      "refs": ["10 §3"],
      "text": "こちらですかね。",
      "expected": true
    },
    {
      "id": "closing-bracket-after-the-question",
      "refs": ["10 §3"],
      "text": "（確認しますか）",
      "expected": true
    },
    {
      "id": "trailing-marks-after-the-question",
      "refs": ["10 §3"],
      "text": "ほかにありますか！…",
      "expected": true
    },
    {
      "id": "statement",
      "refs": ["10 §3"],
      "text": "登録しました。",
      "expected": false
    },
    {
      "id": "statement-with-a-count",
      "refs": ["10 §3"],
      "text": "予定は 2 件です。",
      "expected": false
    },
    {
      "id": "question-word-in-the-middle",
      "refs": ["10 §3"],
      "text": "いかがですかと言っていました。",
      "expected": false
    },
    {
      "id": "ka-but-continues",
      "refs": ["10 §3"],
      "text": "確認しますが、少し待ってください。",
      "expected": false
    },
    {
      "id": "ka-then-a-quote",
      "refs": ["10 §3"],
      "text": "ですか、と聞かれました",
      "expected": false
    },
    {
      "id": "a-lone-ka",
      "refs": ["10 §3"],
