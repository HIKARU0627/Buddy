    },
    {
      "id": "voice-live-without-a-budget-reservation",
      "refs": ["10 §3", "X26"],
      "input_kind": "voice_live",
      "route": "sideband_transcript",
      "satisfied_list": [
        "live_control_ready",
        "audio_epoch_current",
        "session_epoch_current",
        "audio_lease_valid",
        "io_permitted",
        "not_private_conversation",
        "voice_output_mode",
