{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buddy.invalid/tests/test-evidence.v1",
  "title": "TestEvidence",
  "description": "試験結果の記録形式（設計 09 §8、ADR 0011）。case_id は試験 ID か、工程の受入確認（例 B01-mac-lock）。模擬・実機・実 API・実請求を分ける。メール本文・音声・鍵を載せない。結果一覧の正本は非公開の技術検証ページで、この形式はその記録の項目。",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^((X(0[1-9]|[1-5][0-9]|6[0-6])|QA(0[1-9]|[1-3][0-9]|4[0-5])|MA0[1-6])(-[a-z0-9-]+)?|B(0[1-9]|1[0-5])-[a-z0-9-]+)$"
    },
    "kind": {
      "type": "string",
      "enum": ["mock_service", "real_device", "real_api", "real_billing"]
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "contract_version": { "type": "string", "minLength": 1 },
    "db_version": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "hub": { "type": "string", "minLength": 1 },
        "devices": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["os", "hub", "devices"],
      "additionalProperties": false
    },
    "seed": { "type": ["string", "null"] },
    "fault_point": { "type": ["string", "null"] },
    "provider_requests": { "type": "integer", "minimum": 0 },
    "provider_state_changes": { "type": "integer", "minimum": 0 },
    "approvals": { "type": "integer", "minimum": 0 },
    "final_state": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "deviation": { "type": ["string", "null"] },
    "voice_stop_ms": { "type": ["integer", "null"], "minimum": 0 },
    "outcome": {
      "type": "string",
      "enum": ["matched_expectation", "deviated", "aborted"]
    }
  },
  "required": [
    "case_id",
    "kind",
    "commit",
    "contract_version",
    "db_version",
    "environment",
    "seed",
    "fault_point",
    "provider_requests",
    "provider_state_changes",
    "approvals",
    "final_state",
    "observed_at",
    "deviation",
    "voice_stop_ms",
    "outcome"
  ],
  "additionalProperties": false
}
