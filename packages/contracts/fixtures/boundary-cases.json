        "expected": "delivery_unknown"
      },
      {
        "record": {
          "notification_key": "key-3",
          "reminder_id": "",
          "status": "intent_saved"
        },
        "ack": "received",
        "expected": "delivered"
      },
      {
        "record": {
          "notification_key": "key-3",
          "reminder_id": "",
          "status": "delivery_unknown"
        },
        "ack": "received",
        "expected": "delivery_unknown"
      }
