{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src/renderer",
    "outDir": "dist/renderer-test",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"],
  "exclude": ["dist", "node_modules", "src/renderer/main.tsx"]
}
