        {
          "at": 0,
          "add": ["g1"],
          "context": {
            "blocked": "guest_mode"
          },
          "expect": {
            "action": "screen_only",
            "reason": "guest_mode",
            "item_ids": ["g1"]
          }
        }
      ]
    },
    {
      "id": "global-stop-gets-a-screen-notice-only",
      "refs": ["10 §7", "X29"],
      "steps": [
        {
          "at": 0,
          "add": ["s1"],
          "context": {
            "blocked": "global_stop"
          },
          "expect": {
