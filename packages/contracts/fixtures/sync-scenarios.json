{
  "status": "specification_only",
  "description": "同期の走査の排他・公開前の照合の期待値（設計 11 §1・§1A F04、QA44・QA18・QA19・QA36）。手で書いたもので、domain の実装から生成していない。validate は試験装置が走査を validated にする操作、set_scope は外部の変化（再起動による担当の交代、範囲の変更など）を表す。",
  "initial_scope": {
    "scopeId": "scope-mail",
    "scopeRevision": "1",
    "activeScanId": null,
    "activeGeneration": "5",
    "committedWatermark": "2030-10-05T00:00:00Z",
    "providerCursor": "h100",
    "executorGeneration": "2",
    "lastIncrementalCompletedAt": null,
    "lastFullReconciledAt": null,
    "pendingIncremental": false,
    "pendingFull": false,
    "analysisPlanCompleteGeneration": "5"
  },
  "scenarios": [
    {
      "id": "qa44-long-full-then-incremental",
      "title": "長い全量 A の途中で増分・全量の要求はまとめて待つ。A の token 失効後に B を公開し、A の遅着は保存も公開もしない",
      "steps": [
        {
          "op": "request",
          "scan": "A",
          "kind": "full",
          "now": "2030-10-05T01:00:00Z",
          "expected": { "action": "started" }
        },
        {
          "op": "request",
          "scan": "B",
          "kind": "incremental",
          "now": "2030-10-05T01:05:00Z",
          "expected": { "action": "queued" },
          "scope": { "pendingIncremental": true, "activeScanId": "A" }
        },
        {
          "op": "request",
          "scan": "C",
          "kind": "full",
          "now": "2030-10-05T01:06:00Z",
          "expected": { "action": "queued" },
          "scope": { "pendingFull": true }
        },
        {
          "op": "abandon",
          "scan": "A",
          "scope": { "activeScanId": null, "pendingFull": true }
        },
        {
          "op": "request",
          "scan": "B2",
          "kind": "incremental",
          "now": "2030-10-05T01:10:00Z",
          "expected": { "action": "started" },
          "scope": { "pendingIncremental": false, "pendingFull": true }
        },
        { "op": "validate", "scan": "B2" },
        {
          "op": "publish",
          "scan": "B2",
          "diff": 3,
          "cursor": "h120",
          "completedAt": "2030-10-05T01:12:00Z",
          "expected": { "ok": true },
          "scope": {
            "activeGeneration": "6",
            "committedWatermark": "2030-10-05T01:10:00Z",
            "providerCursor": "h120",
            "activeScanId": null,
            "lastIncrementalCompletedAt": "2030-10-05T01:12:00Z"
          }
        },
        { "op": "check", "scan": "A", "expected": ["stale_scan"] },
        {
          "op": "publish",
          "scan": "A",
          "diff": 9,
          "cursor": "h090",
          "completedAt": "2030-10-05T01:20:00Z",
          "expected": {
            "ok": false,
            "reasons": [
              "stale_scan",
              "not_validated",
              "generation_changed",
              "cursor_changed",
              "clock_regression"
            ]
          },
          "scope": {
            "activeGeneration": "6",
            "committedWatermark": "2030-10-05T01:10:00Z",
            "providerCursor": "h120"
          },
          "batch": { "status": "abandoned" }
        }
      ]
    },
    {
      "id": "qa36-no-diff",
      "title": "全量照合で差分ゼロでも公開前の照合を行い、世代は進めず watermark と完了時刻だけ更新する",
      "steps": [
        {
          "op": "request",
          "scan": "F",
          "kind": "full",
          "now": "2030-10-05T02:00:00Z",
          "expected": { "action": "started" }
        },
        { "op": "validate", "scan": "F" },
        {
          "op": "publish",
          "scan": "F",
          "diff": 0,
          "cursor": "h100",
          "completedAt": "2030-10-05T02:30:00Z",
          "expected": { "ok": true },
          "scope": {
            "activeGeneration": "5",
            "committedWatermark": "2030-10-05T02:00:00Z",
            "lastFullReconciledAt": "2030-10-05T02:30:00Z",
            "analysisPlanCompleteGeneration": "5"
          }
        }
      ]
    },
    {
      "id": "old-executor",
      "title": "再起動で担当が替わった後、旧担当の走査は公開できず abandoned になる",
      "steps": [
        {
          "op": "request",
          "scan": "E",
          "kind": "incremental",
          "now": "2030-10-05T03:00:00Z",
          "expected": { "action": "started" }
        },
        { "op": "set_scope", "changes": { "executorGeneration": "3" } },
        { "op": "check", "scan": "E", "expected": ["executor_changed"] },
        { "op": "validate", "scan": "E" },
        {
          "op": "publish",
          "scan": "E",
          "diff": 1,
          "cursor": "h101",
          "completedAt": "2030-10-05T03:05:00Z",
          "expected": { "ok": false, "reasons": ["executor_changed"] },
          "scope": { "activeScanId": null, "activeGeneration": "5" },
          "batch": { "status": "abandoned" }
        }
      ]
    },
    {
      "id": "scope-changed",
      "title": "取得範囲が変わった後は旧 scope の走査を新しい範囲の最新状態として採用しない",
      "steps": [
        {
          "op": "request",
          "scan": "G",
          "kind": "incremental",
          "now": "2030-10-05T04:00:00Z",
          "expected": { "action": "started" }
        },
        { "op": "set_scope", "changes": { "scopeRevision": "2" } },
        { "op": "validate", "scan": "G" },
        {
          "op": "publish",
          "scan": "G",
          "diff": 2,
          "cursor": "h102",
          "completedAt": "2030-10-05T04:05:00Z",
          "expected": { "ok": false, "reasons": ["scope_changed"] },
          "scope": {
            "activeScanId": null,
            "committedWatermark": "2030-10-05T00:00:00Z"
          }
        }
      ]
    },
    {
      "id": "clock-regression",
      "title": "走査の開始時刻が保存済みの watermark より前なら開始を保留する",
      "steps": [
        {
          "op": "request",
          "scan": "H",
          "kind": "incremental",
          "now": "2030-10-04T23:00:00Z",
          "expected": { "action": "held", "reason": "clock_regression" },
          "scope": { "activeScanId": null }
        }
      ]
    },
    {
      "id": "publish-cas-and-validation",
      "title": "検証前の公開は拒否するが走査は続けられる。保存済みの cursor が開始時と違えば原子的に拒否する",
      "steps": [
        {
          "op": "request",
          "scan": "I",
          "kind": "incremental",
          "now": "2030-10-05T05:00:00Z",
          "expected": { "action": "started" }
        },
        {
          "op": "publish",
          "scan": "I",
          "diff": 1,
          "cursor": "h103",
          "completedAt": "2030-10-05T05:01:00Z",
          "expected": { "ok": false, "reasons": ["not_validated"] },
          "scope": { "activeScanId": "I" },
          "batch": { "status": "fetching" }
        },
        { "op": "set_scope", "changes": { "providerCursor": "h999" } },
        { "op": "validate", "scan": "I" },
        {
          "op": "publish",
          "scan": "I",
          "diff": 1,
          "cursor": "h104",
          "completedAt": "2030-10-05T05:02:00Z",
          "expected": { "ok": false, "reasons": ["cursor_changed"] },
          "scope": {
            "activeScanId": null,
            "providerCursor": "h999",
            "activeGeneration": "5"
          },
          "batch": { "status": "abandoned" }
        }
      ]
    }
  ]
}
