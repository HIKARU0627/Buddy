    },
    {
      "id": "a-clock-that-went-back-does-not-open-a-new-connection-early",
      "refs": ["10 §7"],
      "initial": {
        "pending": [],
        "last_connection_at_ms": 500000
      },
      "steps": [
        {
          "at": 100000,
          "add": ["f1"],
          "expect": {
            "action": "wait",
            "retry_at_ms": 160000
          }
        },
        {
          "at": 200000,
          "expect": {
            "action": "defer",
            "retry_at_ms": 800000
          }
        }
      ]
    },
    {
      "id": "nothing-pending",
      "refs": ["10 §7"],
      "steps": [
        {
