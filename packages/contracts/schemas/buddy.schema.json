{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buddy.invalid/contracts/v1",
  "title": "BuddyContract",
  "description": "B00初回範囲。全24意図や全APIの完成を表さない。",
  "anyOf": [
    {
      "$ref": "#/$defs/InputSnapshot"
    },
    {
      "$ref": "#/$defs/LabelMailWireResponse"
    },
    {
      "$ref": "#/$defs/LabelMailInterpretation"
    },
    {
      "$ref": "#/$defs/ActionReadiness"
    },
    {
      "$ref": "#/$defs/LabelOperationIntent"
    },
    {
      "$ref": "#/$defs/CommandContext"
    },
    {
      "$ref": "#/$defs/PreviewRequest"
    },
    {
      "$ref": "#/$defs/LabelPreview"
    },
    {
      "$ref": "#/$defs/ApprovalRequest"
    },
    {
      "$ref": "#/$defs/StateCommand"
    },
    {
      "$ref": "#/$defs/CommandReceipt"
    },
    {
      "$ref": "#/$defs/OperationSnapshot"
    },
    {
      "$ref": "#/$defs/EventEnvelope"
    },
    {
      "$ref": "#/$defs/EventPage"
    },
    {
      "$ref": "#/$defs/ApiError"
    },
    {
      "$ref": "#/$defs/BudgetReservation"
    },
    {
      "$ref": "#/$defs/CreditObservation"
    },
    {
      "$ref": "#/$defs/ModelEvaluationPlan"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "B00初版のランダムUUID v4。認証情報ではない。"
    },
    "Revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "非負整数の10進文字列。各フィールドの版の意味は互換ではない。"
    },
    "UtcTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC RFC 3339。元の地域時間と終日は別に扱う。"
    },
    "LocalDate": {
      "type": "string",
      "format": "date"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "description": "通貨単位の百万分の一を整数文字列で表す。通貨変換はしない。"
    },
    "Money": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        }
      },
      "required": ["currency", "amount"],
      "additionalProperties": false
    },
    "IntentName": {
      "type": "string",
      "enum": [
        "query_schedule",
        "query_mail",
        "query_tasks",
        "query_memory",
        "create_task",
        "create_note",
        "label_mail",
        "draft_reply",
        "create_event",
        "update_event",
        "send_mail",
        "trash_mail",
        "undo_action",
        "update_task",
        "research",
        "memory_save",
        "memory_forget",
        "memory_correct",
        "dev_status",
        "handoff_screen",
        "smalltalk",
        "general_question",
        "consult",
        "unclear"
      ]
    },
    "AudioRange": {
      "type": "object",
      "properties": {
        "audio_epoch": {
          "$ref": "#/$defs/Id"
        },
        "first_frame_seq": {
          "$ref": "#/$defs/Revision"
        },
        "last_frame_seq": {
          "$ref": "#/$defs/Revision"
        },
        "start_sample": {
          "$ref": "#/$defs/Revision"
        },
        "end_sample": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "audio_epoch",
        "first_frame_seq",
        "last_frame_seq",
        "start_sample",
        "end_sample"
      ],
      "additionalProperties": false
    },
    "InputSnapshot": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "buddy.input.v1"
            },
            "input_id": {
              "$ref": "#/$defs/Id"
            },
            "session_id": {
              "$ref": "#/$defs/Id"
            },
            "workflow_id": {
              "$ref": "#/$defs/Id"
            },
            "turn_id": {
              "$ref": "#/$defs/Id"
            },
            "request_revision": {
              "$ref": "#/$defs/Revision"
            },
            "transcript_revision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Revision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "$ref": "#/$defs/UtcTime"
            },
            "state": {
              "type": "string",
              "const": "sealed"
            },
            "sealReason": {
              "type": "string",
              "const": "submitted_text"
            },
            "input_evidence": {
              "type": "string",
              "const": "submitted_text"
            },
            "audio": {
              "type": "null"
            },
            "policy_version": {
              "type": "null"
            }
          },
          "required": [
            "schema",
            "input_id",
            "session_id",
            "workflow_id",
            "turn_id",
            "request_revision",
            "transcript_revision",
            "text",
            "captured_at",
            "state",
            "sealReason",
            "input_evidence",
            "audio",
            "policy_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "buddy.input.v1"
            },
            "input_id": {
              "$ref": "#/$defs/Id"
            },
            "session_id": {
              "$ref": "#/$defs/Id"
            },
            "workflow_id": {
              "$ref": "#/$defs/Id"
            },
            "turn_id": {
              "$ref": "#/$defs/Id"
            },
            "request_revision": {
              "$ref": "#/$defs/Revision"
            },
            "transcript_revision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Revision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "$ref": "#/$defs/UtcTime"
            },
            "state": {
              "type": "string",
              "const": "sealed"
            },
            "sealReason": {
              "type": "string",
              "const": "user_corrected"
            },
            "input_evidence": {
              "type": "string",
              "const": "submitted_text"
            },
            "audio": {
              "type": "null"
            },
            "policy_version": {
              "type": "null"
            }
          },
          "required": [
            "schema",
            "input_id",
            "session_id",
            "workflow_id",
            "turn_id",
            "request_revision",
            "transcript_revision",
            "text",
            "captured_at",
            "state",
            "sealReason",
            "input_evidence",
            "audio",
            "policy_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "buddy.input.v1"
            },
            "input_id": {
              "$ref": "#/$defs/Id"
            },
            "session_id": {
              "$ref": "#/$defs/Id"
            },
            "workflow_id": {
              "$ref": "#/$defs/Id"
            },
            "turn_id": {
              "$ref": "#/$defs/Id"
            },
            "request_revision": {
              "$ref": "#/$defs/Revision"
            },
            "transcript_revision": {
              "$ref": "#/$defs/Revision"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "$ref": "#/$defs/UtcTime"
            },
            "state": {
              "type": "string",
              "const": "sealed"
            },
            "sealReason": {
              "type": "string",
              "const": "local_asr_segment"
            },
            "input_evidence": {
              "type": "string",
              "const": "full_audio_segment"
            },
            "audio": {
              "$ref": "#/$defs/AudioRange"
            },
            "policy_version": {
              "type": "null"
            }
          },
          "required": [
            "schema",
            "input_id",
            "session_id",
            "workflow_id",
            "turn_id",
            "request_revision",
            "transcript_revision",
            "text",
            "captured_at",
            "state",
            "sealReason",
            "input_evidence",
            "audio",
            "policy_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "buddy.input.v1"
            },
            "input_id": {
              "$ref": "#/$defs/Id"
            },
            "session_id": {
              "$ref": "#/$defs/Id"
            },
            "workflow_id": {
              "$ref": "#/$defs/Id"
            },
            "turn_id": {
              "$ref": "#/$defs/Id"
            },
            "request_revision": {
              "$ref": "#/$defs/Revision"
            },
            "transcript_revision": {
              "$ref": "#/$defs/Revision"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "$ref": "#/$defs/UtcTime"
            },
            "state": {
              "type": "string",
              "const": "sealed"
            },
            "sealReason": {
              "type": "string",
              "const": "live_transcript_policy"
            },
            "input_evidence": {
              "type": "string",
              "const": "live_policy_observed"
            },
            "audio": {
              "$ref": "#/$defs/AudioRange"
            },
            "policy_version": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "schema",
            "input_id",
            "session_id",
            "workflow_id",
            "turn_id",
            "request_revision",
            "transcript_revision",
            "text",
            "captured_at",
            "state",
            "sealReason",
            "input_evidence",
            "audio",
            "policy_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "buddy.input.v1"
            },
            "input_id": {
              "$ref": "#/$defs/Id"
            },
            "session_id": {
              "$ref": "#/$defs/Id"
            },
            "workflow_id": {
              "$ref": "#/$defs/Id"
            },
            "turn_id": {
              "$ref": "#/$defs/Id"
            },
            "request_revision": {
              "$ref": "#/$defs/Revision"
            },
            "transcript_revision": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Revision"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string"
            },
            "captured_at": {
              "$ref": "#/$defs/UtcTime"
            },
            "state": {
              "type": "string",
              "enum": ["collecting", "end_candidate", "superseded", "blocked"]
            },
            "sealReason": {
              "type": "null"
            },
            "input_evidence": {
              "type": "string",
              "enum": [
                "submitted_text",
                "full_audio_segment",
                "live_policy_observed",
                "unverified"
              ]
            },
            "audio": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AudioRange"
                },
                {
                  "type": "null"
                }
              ]
            },
            "policy_version": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Revision"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "schema",
            "input_id",
            "session_id",
            "workflow_id",
            "turn_id",
            "request_revision",
            "transcript_revision",
            "text",
            "captured_at",
            "state",
            "sealReason",
            "input_evidence",
            "audio",
            "policy_version"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Coreが付与する入力根拠。LLMや端末の申告をそのまま信用しない。sealedだけでは実行許可にならない。"
    },
    "LabelMailWireResponse": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string",
          "const": "label_mail"
        },
        "target_candidate_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "add_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "remove_labels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "type": "string",
          "enum": ["new", "clarification", "correction", "cancel"]
        },
        "target_workflow_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "reply_text": {
          "type": "null"
        },
        "clarify_question": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "intent",
        "target_candidate_id",
        "add_labels",
        "remove_labels",
        "relation",
        "target_workflow_id",
        "reply_text",
        "clarify_question",
        "confidence"
      ],
      "additionalProperties": false,
      "description": "24意図のうち最初のlabel_mailプロファイルだけ。root object、全フィールド必須、欠落はnull。承認・effect_kind・状態・根拠をモデルに生成させない。"
    },
    "FieldEvidence": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": ["target_candidate_id", "add_labels", "remove_labels"]
        },
        "input_id": {
          "$ref": "#/$defs/Id"
        },
        "request_revision": {
          "$ref": "#/$defs/Revision"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "start_utf16": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf16": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "field",
        "input_id",
        "request_revision",
        "quote",
        "start_utf16",
        "end_utf16"
      ],
      "additionalProperties": false
    },
    "LabelMailInterpretation": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "buddy.interpretation.label-mail.v1"
        },
        "input_id": {
          "$ref": "#/$defs/Id"
        },
        "workflow_id": {
          "$ref": "#/$defs/Id"
        },
        "request_revision": {
          "$ref": "#/$defs/Revision"
        },
        "intent": {
          "type": "string",
          "const": "label_mail"
        },
        "relation": {
          "type": "string",
          "enum": ["new", "clarification", "correction", "cancel"]
        },
        "target_workflow_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "args": {
          "type": "object",
          "properties": {
            "target_candidate_id": {
              "$ref": "#/$defs/Id"
            },
            "add_labels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "remove_labels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": ["target_candidate_id", "add_labels", "remove_labels"],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldEvidence"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema",
        "input_id",
        "workflow_id",
        "request_revision",
        "intent",
        "relation",
        "target_workflow_id",
        "args",
        "evidence"
      ],
      "additionalProperties": false,
      "description": "Coreの対象解決・意味検証後のみ作成可能。契約検証だけで検証済みにはならない。"
    },
    "ActionReadiness": {
      "type": "object",
      "properties": {
        "workflow_id": {
          "$ref": "#/$defs/Id"
        },
        "request_revision": {
          "$ref": "#/$defs/Revision"
        },
        "state": {
          "type": "string",
          "enum": ["blocked", "preview_only", "needs_approval", "auto_eligible"]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_version": {
          "$ref": "#/$defs/Revision"
        },
        "permission_revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "workflow_id",
        "request_revision",
        "state",
        "reason_codes",
        "policy_version",
        "permission_revision"
      ],
      "additionalProperties": false,
      "description": "Core計算結果。auto_eligibleも最終transactionの再検査を省略しない。"
    },
    "LabelOperationIntent": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "buddy.operation.v1"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "content_version": {
          "$ref": "#/$defs/Revision"
        },
        "permission_revision": {
          "$ref": "#/$defs/Revision"
        },
        "provider": {
          "type": "string",
          "enum": ["mock", "gmail", "microsoft_graph"]
        },
        "account_id": {
          "$ref": "#/$defs/Id"
        },
        "target": {
          "type": "object",
          "properties": {
            "remote_id": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["remote_id", "source_revision"],
          "additionalProperties": false
        },
        "action": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mail.labels.change"
            },
            "add": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "remove": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": ["kind", "add", "remove"],
          "additionalProperties": false
        },
        "effects": {
          "type": "object",
          "properties": {
            "external_recipients": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 0
            },
            "reconcile_scope": {
              "type": "string",
              "const": "exact_target"
            }
          },
          "required": ["external_recipients", "reconcile_scope"],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "operation_id",
        "content_version",
        "permission_revision",
        "provider",
        "account_id",
        "target",
        "action",
        "effects"
      ],
      "additionalProperties": false,
      "description": "H01のラベル変更のみ。content_hashはこの確定intent全体のJCS+SHA-256。依頼ID・表示端末・state_revisionを混ぜない。"
    },
    "CommandContext": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "command_scope_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": ["request_id", "command_scope_id"],
      "additionalProperties": false
    },
    "PreviewRequest": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "command_scope_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": ["request_id", "command_scope_id"],
      "additionalProperties": false
    },
    "LabelPreview": {
      "type": "object",
      "properties": {
        "preview_id": {
          "$ref": "#/$defs/Id"
        },
        "intent": {
          "$ref": "#/$defs/LabelOperationIntent"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "state_revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": ["preview_id", "intent", "content_hash", "state_revision"],
      "additionalProperties": false
    },
    "ApprovalRequest": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Id"
        },
        "command_scope_id": {
          "$ref": "#/$defs/Id"
        },
        "preview_id": {
          "$ref": "#/$defs/Id"
        },
        "content_version": {
          "$ref": "#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "expected_state_revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "request_id",
        "command_scope_id",
        "preview_id",
        "content_version",
        "content_hash",
        "expected_state_revision"
      ],
      "additionalProperties": false
    },
