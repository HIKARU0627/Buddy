{
  "name": "@buddy/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "buddy-core": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@buddy/connectors": "workspace:*",
    "@buddy/contracts": "workspace:*",
    "@buddy/domain": "workspace:*",
    "@buddy/platform": "workspace:*",
    "@buddy/storage": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2",
    "yaml": "2.9.1"
  }
}
