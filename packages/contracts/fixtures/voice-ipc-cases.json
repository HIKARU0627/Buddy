{
  "status": "specification_only",
  "description": "音声レンダラーへの限定 IPC の ACK・タイムアウト・世代の期待値（設計 10 §1・§1A、X13・X30・QA43、ADR 0038）。手で書いたもので、domain の実装から生成していない。basis が provisional の値は原本に決めがなく、T04 の実測まで置く仮の値で、合格値ではない。 accept_ack_cases と retain_cases は、停止・失効・再接続の後に届く遅着の ACK を使わないことの期待値（current は current_base を上書きする項目）。",
  "timeouts": {
    "voice.start": {
      "max_ack_timeout_ms": 3000,
      "on_timeout": "close_session",
      "basis": "provisional"
    },
    "voice.stop_playback": {
      "max_ack_timeout_ms": 300,
      "on_timeout": "escalate_suspend_io",
      "basis": "provisional"
    },
    "voice.close_voice_session": {
      "max_ack_timeout_ms": 1500,
      "on_timeout": "force_kill_renderer",
      "basis": "provisional"
    },
    "voice.suspend_io": {
      "max_ack_timeout_ms": 300,
      "on_timeout": "force_kill_renderer",
      "basis": "design"
    },
    "voice.play": {
      "max_ack_timeout_ms": 500,
      "on_timeout": "ignore",
      "basis": "provisional"
    },
    "voice.set_silence_timeout": {
      "max_ack_timeout_ms": 500,
      "on_timeout": "ignore",
      "basis": "provisional"
    }
  },
  "playback_resume_cases": [
    {
      "id": "default-is-a-new-live-connection",
      "refs": ["10 §1A", "ADR 0038", "#15 計画の確認事項"],
      "same_connection_playback_resume": false,
      "old_stream_excluded": false,
      "expected": "new_live_connection"
    },
    {
      "id": "setting-off-even-if-the-old-stream-looks-excluded",
      "refs": ["10 §1A", "ADR 0038"],
      "same_connection_playback_resume": false,
      "old_stream_excluded": true,
      "expected": "new_live_connection"
    },
    {
      "id": "setting-on-but-the-old-stream-is-not-confirmed-gone",
      "refs": ["10 §1A", "ADR 0038", "QA43"],
      "same_connection_playback_resume": true,
      "old_stream_excluded": false,
      "expected": "new_live_connection"
    },
    {
      "id": "setting-on-and-the-old-stream-is-confirmed-gone",
      "refs": ["10 §1A", "ADR 0038", "QA43"],
      "same_connection_playback_resume": true,
      "old_stream_excluded": true,
      "expected": "same_connection"
    }
  ],
