{
  "status": "specification_only",
  "description": "承認の受付・DB 命令の再検査・通知の配信・削除期限の期待値（設計 03 保存期限、08 §1・§3・§5・§7、11 §4・§9、J12、X02・X12、ADR 0010）。手で書いたもので、domain の実装から生成していない。",
  "approval": {
    "operation": {
      "operation_id": "op-1",
      "current_content_version": "2",
      "content_hash": "hash-2",
      "state_revision": "5",
      "state": "awaiting_approval",
      "effective_approval": null
    },
    "attempt": {
      "route": "screen",
      "content_version": "2",
      "content_hash": "hash-2",
      "expected_state_revision": "5",
      "preview_valid": true,
      "policy_version": null,
      "current_policy_version": "3"
    },
    "cases": [
      { "id": "record", "expected": { "action": "record", "reasons": [] } },
      {
        "id": "x02-second-device-same-content",
        "title": "別の端末から同じ内容を承認しても、新しい承認は作らず既存の状態を返す",
        "operation": {
          "state": "approved",
          "state_revision": "6",
          "effective_approval": {
            "content_version": "2",
            "content_hash": "hash-2"
          }
        },
        "attempt": { "expected_state_revision": "5" },
        "expected": { "action": "existing", "reasons": [] }
      },
      {
        "id": "old-content-version",
        "attempt": { "content_version": "1", "content_hash": "hash-1" },
        "expected": {
          "action": "reject",
          "reasons": ["content_version_changed", "content_hash_mismatch"]
        }
      },
      {
        "id": "approved-version-differs",
        "operation": {
          "effective_approval": {
            "content_version": "2",
            "content_hash": "hash-x"
          }
        },
        "expected": { "action": "reject", "reasons": ["approval_conflict"] }
      },
      {
        "id": "stale-state-and-preview",
        "attempt": { "expected_state_revision": "4", "preview_valid": false },
        "expected": {
          "action": "reject",
          "reasons": ["state_revision_changed", "preview_invalid"]
        }
      },
      {
        "id": "cancelled-operation",
        "operation": { "state": "cancelled" },
        "expected": { "action": "reject", "reasons": ["not_awaiting_approval"] }
      },
      {
        "id": "policy-auto-current",
        "attempt": {
          "route": "policy_auto",
          "preview_valid": false,
          "policy_version": "3"
        },
        "expected": { "action": "record", "reasons": [] }
      },
      {
        "id": "policy-auto-old-policy",
        "attempt": {
          "route": "policy_auto",
          "preview_valid": false,
          "policy_version": "2"
        },
        "expected": {
          "action": "reject",
          "reasons": ["policy_version_changed"]
        }
      }
    ]
  },
  "command": {
    "command": {
      "command_id": "cmd-1",
      "kind": "operation.dispatch",
      "expected_state_revision": "5",
      "request_revision": "2",
      "permission_revision": "4",
      "forgetting_generation": "7"
    },
    "current": {
      "state_revision": "5",
      "request_revision": "2",
      "permission_revision": "4",
      "forgetting_generation": "7",
      "applied_command_ids": [],
      "safety_stopped": false,
      "reservation_valid": true
    },
    "cases": [
      {
        "id": "apply",
        "external": true,
        "expected": { "action": "apply", "reasons": [] }
      },
      {
        "id": "lost-ack-redelivery",
        "title": "ACK を失った命令の再到着は既存の結果を返し、再度変更しない",
        "external": true,
        "current": { "applied_command_ids": ["cmd-1"], "state_revision": "6" },
        "expected": { "action": "already_applied", "reasons": [] }
      },
      {
        "id": "versions-changed",
        "external": false,
        "current": {
          "state_revision": "6",
          "request_revision": "3",
          "permission_revision": "5",
          "forgetting_generation": "8"
        },
        "expected": {
          "action": "reject",
          "reasons": [
            "state_revision_changed",
            "request_revision_changed",
            "permission_changed",
            "forgetting_generation_changed"
          ]
        }
      },
      {
        "id": "dispatch-while-stopped-or-unreserved",
        "external": true,
        "current": { "safety_stopped": true, "reservation_valid": false },
        "expected": {
          "action": "reject",
          "reasons": ["safety_stopped", "reservation_invalid"]
        }
      },
      {
        "id": "local-command-ignores-dispatch-only-checks",
        "external": false,
        "current": { "safety_stopped": true, "reservation_valid": false },
        "expected": { "action": "apply", "reasons": [] }
      }
    ]
  },
