        "missing": ["budget_reserved"]
      }
    },
    {
      "id": "voice-live-with-nothing-satisfied",
      "refs": ["ADR 0038"],
      "input_kind": "voice_live",
      "route": "sideband_transcript",
      "satisfied_list": [],
      "expected": {
        "decision": "reject",
