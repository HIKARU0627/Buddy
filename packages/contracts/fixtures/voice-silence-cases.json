      "expected": false
    },
    {
      "id": "empty",
      "refs": ["10 §3"],
      "text": "",
      "expected": false
    },
    {
      "id": "statement-with-ne",
      "refs": ["10 §3"],
      "text": "明日は雨ですね",
      "expected": false
    }
