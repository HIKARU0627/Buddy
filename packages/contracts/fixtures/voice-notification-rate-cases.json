    {
      "id": "the-same-notice-twice-is-read-once",
      "refs": ["10 §7", "X12"],
      "steps": [
        {
          "at": 0,
          "add": ["d1", "d1"],
          "expect": {
            "action": "wait",
            "retry_at_ms": 60000
          }
        },
        {
          "at": 60000,
          "expect": {
            "action": "read_new_connection",
            "item_ids": ["d1"]
          }
        }
      ]
    },
    {
      "id": "a-clock-that-went-back-keeps-waiting",
      "refs": ["10 §7"],
      "steps": [
        {
