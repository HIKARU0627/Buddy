{
  "status": "specification_only",
  "description": "3 層の停止の時間モデルの期待値（設計 10 §1・§1A・§9、09 X13・X30・QA43、ADR 0041）。手で書いたもので、domain の実装から生成していない。第 1 層の 200ms は目標、第 2 層の 300ms は強制終了の期限で、どちらも設計の初期値であり合格値ではない（質問 44。実測は T04）。時刻は注入した単調時計の値（ms）。stop_playback の ACK が返らないときの全停止の理由は、新しい理由を足さず既存の device_io_stop（local）を使う（ADR 0041）。",
  "constants": { "layer1_target_ms": 200, "layer2_deadline_ms": 300 },
  "plan_cases": [
    {
      "id": "plan-user-stop",
      "refs": ["10 §1A", "QA43"],
      "reason": "user_stop",
      "expected": {
        "action": "stop_playback",
        "channel": "voice.stop_playback",
        "local": [
          "mute_playback",
          "discard_queued_audio",
          "advance_output_epoch"
        ],
        "ack_deadline_ms": 300,
        "core": []
      }
    },
    {
      "id": "plan-barge-in",
      "refs": ["10 §1A", "QA43"],
      "reason": "barge_in",
      "expected": {
        "action": "stop_playback",
        "channel": "voice.stop_playback",
        "local": [
          "mute_playback",
          "discard_queued_audio",
          "advance_output_epoch"
        ],
        "ack_deadline_ms": 300,
        "core": []
      }
    },
    {
      "id": "plan-silence-closes-live-but-keeps-the-microphone",
      "refs": ["10 §1A", "10 §2"],
      "reason": "silence",
      "expected": {
        "action": "close_voice_session",
        "channel": "voice.close_voice_session",
        "local": [
          "mute_playback",
          "discard_queued_audio",
          "disable_live_send",
          "close_webrtc",
          "advance_output_epoch"
        ],
        "ack_deadline_ms": 1500,
        "core": ["core_sideband_close", "reconcile_usage_hold_reservation"]
      }
    },
    {
      "id": "plan-consent-revoked-closes-live",
      "refs": ["10 §1A", "ADR 0038"],
      "reason": "consent_revoked",
      "expected": {
        "action": "close_voice_session",
        "channel": "voice.close_voice_session",
        "local": [
          "mute_playback",
          "discard_queued_audio",
          "disable_live_send",
          "close_webrtc",
          "advance_output_epoch"
        ],
        "ack_deadline_ms": 1500,
        "core": ["core_sideband_close", "reconcile_usage_hold_reservation"]
      }
    },
    {
      "id": "plan-os-lock-stops-everything",
      "refs": ["10 §1", "10 §1A", "X13", "X30"],
      "reason": "os_lock",
      "expected": {
        "action": "suspend_io",
        "channel": "voice.suspend_io",
        "local": [
          "mute_playback",
          "discard_queued_audio",
          "disable_live_send",
          "close_webrtc",
          "stop_mic_track",
          "discard_pcm_ring",
          "stop_kws_vad_asr_delivery",
          "advance_output_epoch",
          "advance_io_epoch"
        ],
        "ack_deadline_ms": 300,
        "core": [
          "invalidate_old_epoch_results",
          "core_sideband_close",
          "reconcile_usage_hold_reservation"
        ]
      }
    },
    {
      "id": "plan-device-revoked-stops-everything",
      "refs": ["10 §1A", "X13"],
      "reason": "device_revoked",
      "expected": {
        "action": "suspend_io",
        "channel": "voice.suspend_io",
        "local": [
          "mute_playback",
          "discard_queued_audio",
