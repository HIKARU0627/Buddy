{
  "status": "specification_only",
  "description": "B04 の故障点と手書きの期待値。状態履歴は operation-transitions.json と整合検査する。実行結果ではない。X10 の expected は B14 の完了期待で、B04 は b04_expected の工程保存・照合判断だけを検査する。approvals は失効分を含む保存件数。",
  "mock_service": {
    "persists_across_core_restart": true,
    "deduplicates_requests": false,
    "records": [
      "operation_id",
      "attempt_id",
      "step_id",
      "receive_order",
      "applied_change",
      "responded"
    ],
    "rules": [
      "模擬サービスの状態と受信記録は、中枢の再起動とは独立して保持する（中枢と一緒に初期化しない）",
      "要求回数と状態変更回数を分けて記録する",
      "重複要求を自動で消さない。サービス側の冪等性で中枢の二重送出を隠さない",
      "同時承認は固定時間の sleep ではなく、両要求を同じ境界で待たせて解放する制御点で作る",
      "試験装置だけが知る真の結果（例: 送信されていない）を中枢へ教えない"
    ]
  },
  "fault_points": {
    "before_approval_save": "承認の保存前",
    "after_approval_save": "承認の保存後",
    "after_target_recheck": "対象の再確認後",
    "after_dispatch_intent_before_send": "送出意図の保存後・送信前",
    "after_external_apply_before_response": "外部適用後・応答前",
    "before_result_save": "結果の保存前",
    "after_event_delivery_before_ack": "イベント配信後・ACK 前",
    "approval_barrier": "同時承認を同じ境界で待たせる制御点",
    "response_timeout_then_late_apply": "応答タイムアウトの後に模擬サービスが遅れて適用する",
    "core_restart": "中枢だけを再起動する（DB 世代と操作 ID は維持、起動 ID と一時接続は更新）"
  },
