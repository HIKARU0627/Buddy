{
  "status": "specification_only",
  "description": "再送・イベントの反映・リース・停止の到達・ペアリング・API 版の期待値（設計 07 §2〜§5、02 端末登録と接続、X04・X11・X13・X14）。手で書いたもので、domain の実装から生成していない。",
  "replay": {
    "receipts": [
      {
        "command_scope_id": "scope-1",
        "request_id": "req-1",
        "request_hash": "hash-a"
      }
    ],
    "cases": [
      {
        "id": "same-request-same-content",
        "request": {
          "command_scope_id": "scope-1",
          "request_id": "req-1",
          "request_hash": "hash-a"
        },
        "expected": "replay"
      },
      {
        "id": "x04-same-request-different-content",
        "request": {
          "command_scope_id": "scope-1",
          "request_id": "req-1",
          "request_hash": "hash-b"
        },
        "expected": "conflict"
      },
      {
        "id": "new-request",
        "request": {
          "command_scope_id": "scope-1",
          "request_id": "req-2",
          "request_hash": "hash-a"
        },
        "expected": "new"
      },
      {
        "id": "same-id-in-new-scope",
        "title": "新しい接続範囲では別の命令。古い接続範囲の命令は経路の検査で 410 になる",
        "request": {
          "command_scope_id": "scope-2",
          "request_id": "req-1",
          "request_hash": "hash-b"
        },
        "expected": "new"
      }
    ]
  },
  "events": {
    "snapshot": {
      "store_generation": "gen-1",
      "revisions": { "op-1": "3" },
      "seen_event_ids": ["e3"]
    },
    "x11-duplicate-and-out-of-order": {
      "events": [
        {
          "event_id": "e2",
          "store_generation": "gen-1",
          "operation_id": "op-1",
          "state_revision": "2"
        },
        {
          "event_id": "e3",
          "store_generation": "gen-1",
          "operation_id": "op-1",
          "state_revision": "3"
        },
        {
          "event_id": "e4",
          "store_generation": "gen-1",
          "operation_id": "op-1",
          "state_revision": "4"
        },
        {
          "event_id": "e4",
          "store_generation": "gen-1",
          "operation_id": "op-1",
          "state_revision": "4"
        },
        {
          "event_id": "e6",
          "store_generation": "gen-1",
          "operation_id": "op-1",
          "state_revision": "6"
        },
        {
          "event_id": "e5",
          "store_generation": "gen-1",
          "operation_id": "op-1",
          "state_revision": "5"
