            "request_id",
            "command_id",
            "operation_id",
            "state_revision",
            "status",
            "committed_state_revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "request_id": {
              "$ref": "#/$defs/Id"
