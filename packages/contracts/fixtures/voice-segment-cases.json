{
  "status": "specification_only",
  "description": "方式 A の区間リング（16kHz・mono・16bit・60 秒まで）と、区間の sealed・blocked・collecting・truncated の期待値（設計 10 §5A、07 §1、09 QA05・QA06・X51、ADR 0041）。手で書いたもので、domain の実装から生成していない。音声は含まず、フレームの番号（frame_seq）と sample の範囲だけを持つ。1 フレームは 20ms = 320 sample、リングの容量は 960000 sample（60 秒）。frames の gen は同じ大きさの連続フレームを n 個作る省略記法（first_seq から連番、start から連続）。sealed は区間を固定したという意味で、誤認識がないことでも実行の許可でもない。",
  "constants": {
    "sample_rate": 16000,
    "channels": 1,
    "bits_per_sample": 16,
    "ring_max_seconds": 60,
    "ring_capacity_samples": 960000,
    "bridge_seconds": 15
  },
  "segment_defaults": {
    "audio_epoch": "7",
    "live_offset_mapping": "verified",
    "target_turn_count": 1,
    "asr": "completed"
  },
  "ring_epoch": "7",
  "push_cases": [
    {
      "id": "push-first-frame",
      "refs": ["10 §5A"],
      "frames": [
        { "gen": { "first_seq": 0, "start": 0, "count": 320, "n": 1 } }
      ],
      "push": { "frame_seq": 1, "start_sample": 320, "sample_count": 320 },
      "expected": {
        "ok": true,
        "duplicate": false,
        "frames": 2,
        "evicted_samples": 0
      }
    },
    {
      "id": "push-the-same-frame-again-is-ignored",
      "refs": ["QA05", "10 §5A"],
      "frames": [
        { "gen": { "first_seq": 0, "start": 0, "count": 320, "n": 2 } }
      ],
      "push": { "frame_seq": 1, "start_sample": 320, "sample_count": 320 },
      "expected": {
        "ok": true,
        "duplicate": true,
        "frames": 2,
        "evicted_samples": 0
      }
    },
    {
      "id": "push-a-conflicting-frame-with-the-same-number",
      "refs": ["QA05"],
      "frames": [
        { "gen": { "first_seq": 0, "start": 0, "count": 320, "n": 2 } }
      ],
      "push": { "frame_seq": 1, "start_sample": 320, "sample_count": 160 },
      "expected": { "ok": false, "reason": "frame_conflict" }
    },
    {
      "id": "push-a-frame-number-that-went-back",
      "refs": ["QA05"],
      "frames": [
        { "gen": { "first_seq": 0, "start": 0, "count": 320, "n": 3 } }
      ],
      "push": { "frame_seq": 1, "start_sample": 320, "sample_count": 320 },
      "expected": { "ok": false, "reason": "frame_seq_regressed" }
    },
    {
      "id": "push-a-frame-from-another-epoch",
      "refs": ["QA06"],
      "frames": [
        { "gen": { "first_seq": 0, "start": 0, "count": 320, "n": 1 } }
      ],
      "epoch": "8",
      "push": { "frame_seq": 1, "start_sample": 320, "sample_count": 320 },
      "expected": { "ok": false, "reason": "audio_epoch_changed" }
    },
    {
      "id": "push-an-empty-frame",
      "refs": ["10 §5A"],
      "frames": [],
      "push": { "frame_seq": 0, "start_sample": 0, "sample_count": 0 },
      "expected": { "ok": false, "reason": "invalid_frame" }
    },
    {
      "id": "push-a-negative-start",
      "refs": ["10 §5A"],
      "frames": [],
      "push": { "frame_seq": 0, "start_sample": -1, "sample_count": 320 },
      "expected": { "ok": false, "reason": "invalid_frame" }
    },
    {
      "id": "push-a-fractional-frame-number",
      "refs": ["10 §5A"],
      "frames": [],
      "push": { "frame_seq": 0.5, "start_sample": 0, "sample_count": 320 },
      "expected": { "ok": false, "reason": "invalid_frame" }
    },
    {
      "id": "push-a-frame-larger-than-the-ring",
      "refs": ["10 §5A"],
      "frames": [],
      "push": { "frame_seq": 0, "start_sample": 0, "sample_count": 960001 },
      "expected": { "ok": false, "reason": "invalid_frame" }
    },
    {
      "id": "ring-exactly-full-evicts-nothing",
      "refs": ["10 §5A"],
      "frames": [
        { "gen": { "first_seq": 0, "start": 0, "count": 320, "n": 2999 } }
      ],
      "push": {
        "frame_seq": 2999,
        "start_sample": 959680,
        "sample_count": 320
      },
      "expected": {
        "ok": true,
        "duplicate": false,
        "frames": 3000,
        "evicted_samples": 0
      }
    },
    {
      "id": "one-more-frame-evicts-the-oldest",
      "refs": ["10 §5A"],
      "frames": [
        { "gen": { "first_seq": 0, "start": 0, "count": 320, "n": 3000 } }
      ],
      "push": {
        "frame_seq": 3000,
        "start_sample": 960000,
        "sample_count": 320
      },
      "expected": {
        "ok": true,
        "duplicate": false,
        "frames": 3000,
        "evicted_samples": 320
      }
    }
  ],
