            "command_id": {
              "$ref": "#/$defs/Id"
            },
            "operation_id": {
              "$ref": "#/$defs/Id"
            },
            "state_revision": {
              "$ref": "#/$defs/Revision"
            },
            "status": {
              "type": "string",
              "const": "durable"
            },
            "committed_state_revision": {
              "$ref": "#/$defs/Revision"
            }
          },
          "required": [
            "request_id",
            "command_id",
            "operation_id",
            "state_revision",
            "status",
            "committed_state_revision"
          ],
          "additionalProperties": false
        }
      ],
      "description": "受付ACKとdurable ACK。どちらも外部変更の成功ではない。"
    },
    "OperationSnapshot": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "content_version": {
          "$ref": "#/$defs/Revision"
        },
        "content_hash": {
          "$ref": "#/$defs/Hash"
        },
        "state_revision": {
          "$ref": "#/$defs/Revision"
        },
        "state": {
          "type": "string",
          "enum": [
            "awaiting_approval",
            "approved",
            "preparing",
            "dispatching",
            "reconciling",
            "succeeded",
            "unknown_held",
            "not_executed",
            "cancelled",
            "superseded"
          ]
        },
        "approval_state": {
          "type": "string",
          "enum": ["none", "valid", "revoked", "expired"]
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["preview", "approve", "cancel", "reconcile", "retry"]
          },
          "uniqueItems": true
        },
        "result": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "confirmed_success",
                    "confirmed_not_executed",
                    "unknown"
                  ]
                },
                "provider_receipt_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["status", "provider_receipt_id"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation_id",
        "content_version",
        "content_hash",
        "state_revision",
        "state",
        "approval_state",
        "allowed_actions",
        "result"
      ],
      "additionalProperties": false,
      "description": "最初のラベル変更用状態投影。allowed_actionsは表示補助であり、実行時の認可ではない。"
    },
